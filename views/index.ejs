<!DOCTYPE html>
<html lang="en">
    <head>
        <!-- set the character encoding -->
        <meta charset="UTF-8">

        <!-- make the page responsive -->
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <!-- title shown in the browser -->
        <title>My Blog Post</title>

        <!-- link to the CSS file -->
        <link rel="stylesheet" href="/style.css">
    </head>

    <body>
        <!-- main heading of the page -->
        <h1>Welcome to My Blog!</h1>

        <!-- display user information -->
        <% if (currentUser) { %>
            <p>Welcome, <%= currentUser.name %>!</p>

            <!-- logout button -->
            <form action="/logout" method="POST">
                <button type="submit">Logout</button>
            </form>
        <% } else { %>
            <a href="/signin">Sign In</a>
            <a href="/signup">Sign Up</a>
        <% } %>

        <!-- only signed-in users can create posts -->
        <% if (currentUser) { %>

            <!-- section for creating a new post -->
            <h2>Create New Post</h2>

            <!-- form used to create a new blog post -->
            <form action="/posts" method="POST">

                <!-- input for the blog title -->
                <label for="title">Blog Title:</label>
                <input type="text" id="title" name="title" required>

                <br><br>

                <!-- input for the blog content -->
                <label for="content">Blog Post:</label>
                <br>
                <textarea id="content" name="content"
                          rows="6" cols="40" required></textarea>

                <br><br>

                <!-- submit button for creating the post -->
                <button type="submit">Create Post</button>
            </form>

        <% } else { %>
            <p>Please sign in to create a blog post.</p>
        <% } %>

        <h2>Blog Posts</h2>

        <!-- loop through every post from PostgreSQL -->
        <% posts.forEach(post => { %>

            <!-- each blog post is displayed inside an article -->
            <article>

                <!-- display the post title -->
                <h3><%= post.title %></h3>

                <!-- display the post content -->
                <p><%= post.body %></p>

                <!-- display the creator's name -->
                <p>By <%= post.creator_name %></p>

                <!-- display the post date -->
                <p>Posted:
                    <%= new Date(post.date_created).toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric"
                    }) %>
                </p>

                <!-- only the creator can edit or delete -->
                <% if (currentUser &&
                       currentUser.user_id === post.creator_user_id) { %>

                    <div class="post-actions">

                        <!-- link to edit specific post -->
                        <a href="/edit/<%= post.blog_id %>">Edit</a>

                        <!-- form used to delete specific post -->
                        <form action="/delete/<%= post.blog_id %>" method="POST">
                            <button type="submit">Delete</button>
                        </form>

                    </div>

                <% } %>

            </article>

        <!-- end of loop -->
        <% }) %>

    </body>
</html>
